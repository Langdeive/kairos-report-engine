# Opcional: compatibilidade de emergencia. Normalmente e descoberto apos o login.
TUTORY_API_TOKEN=
TUTORY_ACCOUNT=replace-locally
TUTORY_PASSWORD=replace-locally
KAIROS_DATA_KEY=generate-a-fernet-key-locally
KAIROS_DATA_DIR=/opt/data/kairos-reports
KAIROS_APPROVAL_MODE=required
KAIROS_RETENTION_MONTHS=12
KAIROS_TIMEZONE=America/Sao_Paulo
KAIROS_RUN_TIME=20:00
TUTORY_HTTP_MAX_ATTEMPTS=3
TUTORY_REQUEST_SPACING_SECONDS=1
TUTORY_RETRY_BASE_SECONDS=1
TUTORY_RETRY_MAX_SECONDS=30
KAIROS_BATCH_SIZE=10
KAIROS_BATCH_PAUSE_SECONDS=30
KAIROS_MAX_CONSECUTIVE_UPSTREAM_FAILURES=3
